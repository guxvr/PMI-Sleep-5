# Server only. Never use a VITE_ prefix for credentials.
WATSONX_API_KEY=
# Copy Service instance URL from Settings > API details.
WATSONX_INSTANCE_URL=
# Deployment agent UUID, not the display name.
WATSONX_AGENT_ID=
# Live environment UUID and published version from the agent API.
WATSONX_ENVIRONMENT_ID=
WATSONX_AGENT_VERSION=
PORT=3001
